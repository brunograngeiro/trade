[Unit]
Description=trade2 — data retention pruner (one-shot)

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/trade2
EnvironmentFile=/home/ubuntu/trade2/.env
ExecStart=/home/ubuntu/trade2/.venv/bin/python /home/ubuntu/trade2/scripts/run_data_retention.py
StandardOutput=append:/home/ubuntu/trade2/data/retention.log
StandardError=append:/home/ubuntu/trade2/data/retention.log
