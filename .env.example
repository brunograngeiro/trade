# Kalshi
KALSHI_API_KEY_ID=your-key-id
KALSHI_PRIVATE_KEY_PATH=./secrets/kalshi_api.keys
KALSHI_BASE_URL=https://api.elections.kalshi.com/trade-api/v2
KALSHI_WS_URL=wss://api.elections.kalshi.com/trade-api/ws/v2
KALSHI_SERIES_TICKER=KXBTC15M

# App
APP_HOST=0.0.0.0
APP_PORT=8020
DASHBOARD_PORT=8501
DB_PATH=./data/trade2.sqlite3

# Trading safety: keep false; flip to true only when you know what you're doing
ENABLE_REAL_ORDERS=false
MAX_ORDER_COST_CENTS=90
DEFAULT_ORDER_SIDE=yes
DEFAULT_ORDER_COUNT=1

# Strategy thresholds
PROB_EXPLOSION_DELTA=0.15
PROB_PLATEAU_THRESHOLD=0.60
PROB_PLATEAU_SECONDS=120
COLLECTOR_POLL_SECONDS=2

LOG_LEVEL=INFO
